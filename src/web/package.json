{
  "name": "metronomics-web",
  "version": "1.0.0",
  "description": "Frontend web application for the Metronomics Platform - a comprehensive web application for strategic planning, execution tracking, and team alignment",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "cypress run",
    "test:e2e:open": "cypress open",
    "prepare": "cd .. && husky install web/.husky"
  },
  "dependencies": {
    "@fullcalendar/daygrid": "^6.1.8",
    "@fullcalendar/interaction": "^6.1.8",
    "@fullcalendar/react": "^6.1.8",
    "@fullcalendar/timegrid": "^6.1.8",
    "@types/node": "^20.4.5",
    "axios": "^1.4.0",
    "chart.js": "^4.3.0",
    "chartjs-plugin-annotation": "^2.2.1",
    "date-fns": "^2.30.0",
    "date-fns-tz": "^2.0.0",
    "firebase": "^9.23.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^2.5.1",
    "jwt-decode": "^3.1.2",
    "loglevel": "^1.8.1",
    "mermaid": "^10.2.4",
    "primeflex": "^4.0.0",
    "primereact": "^10.0.0",
    "qs": "^6.11.0",
    "react": "^18.2.0",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-dom": "^18.2.0",
    "react-feather": "^2.0.10",
    "react-query": "^5.0.0",
    "react-router-dom": "^7.0.0",
    "styled-components": "^6.0.5",
    "styled-normalize": "^8.0.7",
    "zod": "^3.21.4"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^14.0.0",
    "@testing-library/user-event": "^14.4.3",
    "@types/jest": "^29.5.3",
    "@types/qs": "^6.9.7",
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@types/styled-components": "^5.1.26",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "@vitejs/plugin-react": "^4.0.0",
    "axios-mock-adapter": "^1.21.4",
    "cypress": "^12.17.2",
    "eslint": "^8.45.0",
    "eslint-config-prettier": "^8.8.0",
    "eslint-plugin-import": "^2.27.5",
    "eslint-plugin-jsx-a11y": "^6.7.1",
    "eslint-plugin-prettier": "^4.2.1",
    "eslint-plugin-react": "^7.32.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-security": "^1.7.1",
    "husky": "^8.0.3",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.6.1",
    "jest-axe": "^7.0.0",
    "jest-environment-jsdom": "^29.6.1",
    "lint-staged": "^13.2.3",
    "msw": "^1.2.2",
    "prettier": "^2.8.8",
    "terser": "^5.19.2",
    "ts-jest": "^29.1.1",
    "typescript": "^5.1.6",
    "vite": "^4.3.5",
    "vite-plugin-pwa": "^0.14.7",
    "vitest": "^0.34.0",
    "whatwg-fetch": "^3.6.2"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "jsdom",
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setup.ts"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1",
      "\\.(css|less|scss|sass)$": "identity-obj-proxy"
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/organization/metronomics-platform.git"
  },
  "keywords": [
    "metronomics",
    "strategic-planning",
    "team-alignment",
    "business-growth",
    "meeting-management",
    "react",
    "typescript"
  ],
  "author": "Metronomics Team",
  "license": "UNLICENSED",
  "private": true
}