{
  "watch": ["src"],
  "ext": "ts,json",
  "ignore": ["src/**/*.test.ts", "src/**/*.spec.ts", "tests/**/*"],
  "exec": "ts-node -r tsconfig-paths/register src/server.ts",
  "env": {
    "NODE_ENV": "development"
  },
  "delay": "500",
  "restartable": "rs",
  "colours": true,
  "verbose": true,
  "signal": "SIGTERM",
  "events": {
    "restart": "echo \"[Nodemon] App restarted due to changes\""
  }
}